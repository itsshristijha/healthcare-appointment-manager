# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Database (Postgres) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthcare_appointments
# Individual fields are used if DATABASE_URL is not set:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_appointments
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- LLM (optional) ----
# If OPENAI_API_KEY is not set, the system falls back to a deterministic
# rule-based mock summarizer so the app runs fully offline out of the box.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Email (optional) ----
# If SMTP_HOST is not set, emails are logged to the console and to the
# NotificationLog table instead of actually being sent (mock mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Healthcare Appointment Manager <no-reply@clinic.example.com>"

# ---- Google Calendar (optional) ----
# If these are not set, calendar events are mocked (fake event IDs are
# generated and stored, no real Google API calls are made).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# ---- Background jobs ----
MEDICATION_REMINDER_CRON=*/15 * * * *
NOTIFICATION_RETRY_CRON=*/10 * * * *
SLOT_HOLD_TTL_MINUTES=5
NOTIFICATION_MAX_RETRIES=5
